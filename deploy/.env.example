# HPF-Reader 部署配置模板
#   cp .env.example .env   然后替换所有 CHANGE_ME_*
#   生成随机密钥：openssl rand -base64 48
#   ⚠️ 本文件里所有 CHANGE_ME_* 都必须在部署前替换；仓库中不留任何可用凭据。
#   ⚠️ 服务端在 HPF_ENV=prod 下会**主动拒绝**：密钥短于 32 字节、含 CHANGE_ME、
#      或等于本仓库历史默认值 —— 照抄模板起不来说明检查生效了，不是 bug。

# ---------- 域名与 TLS ----------
# 生产填真实域名（Caddy 自动签证书）；本地调试可用 localhost
# 域名必须解析到运行 caddy 的这台机器，并且只映射 caddy 的 80/443。
HPF_DOMAIN=books.example.com
ACME_EMAIL=admin@example.com

# ---------- 服务端 ----------
HPF_ENV=prod
HPF_VERSION=dev
HPF_API_IMAGE=hpf-reader-api:local
HPF_LOG_LEVEL=info
HPF_LOG_FORMAT=json
# 必填：access token 的签名密钥，泄露即可伪造任意账号登录态。
# 这里刻意留 CHANGE_ME：HPF_ENV=prod 下服务端会拒绝含 CHANGE_ME 的值，
# 逼你在部署前生成一个真随机密钥（而不是照抄模板里「看起来像密钥」的串）。
#   openssl rand -base64 48
# 至少 32 字节；启动日志里的 jwt_key_fp 可用于核对是否真的换过。
HPF_JWT_SECRET=CHANGE_ME_generate_a_random_48_byte_secret
HPF_ACCESS_TOKEN_TTL=15m
HPF_REFRESH_TOKEN_TTL=720h
# 同一「账号 + 来源 IP」在窗口内允许的失败次数，超过后该 IP 对该账号返回 429。
# 口令正确时永远放行，因此这个机制不能被用来锁死别人的账号。
HPF_LOGIN_MAX_FAILURES=5
# 账号级失败阈值（跨 IP 累计）：只用于审计与分布式爆破观测，不阻断正确口令。
HPF_LOGIN_ACCOUNT_LOCK_FAILURES=20
HPF_LOGIN_LOCK_WINDOW=15m
# 注册默认关闭。开放注册 = 任何人可消耗你的 AI 配额与磁盘；确需公开注册时
# 再改成 true，并同时收紧 HPF_AI_DAILY_QUOTA 与单用户 quota_bytes。
HPF_REGISTER_OPEN=false
# 口令哈希（每次 ~64MiB）的并发闸门；容器内存至少 4 × 64MiB + 余量。
HPF_HASH_CONCURRENCY=4
# 每 IP 每分钟请求上限（依赖 HPF_TRUSTED_PROXIES 正确才能取到真实 IP）
HPF_RATE_LIMIT_AUTH=20
HPF_RATE_LIMIT_API=600
# 指标默认关闭。开启后必须确认 /metrics 只在内网可达（Caddy 的 remote_ip
# 规则只看 TCP 对端，前置代理/隧道会让它失效）。
HPF_METRICS_ENABLED=false
# 允许的跨域来源（多个用逗号分隔）。留空 = 不放开任何跨域来源。
# 桌面端是 wails:// 原生壳、Web 端与 API 同源，都不需要 CORS。
HPF_CORS_ORIGINS=
# 可信反向代理网段：只有来自这些地址的请求才采信 X-Forwarded-For。
# 默认值 = docker-compose 里 edge 网络的固定网段（caddy 所在网络）。
# ⚠️ 千万不要填 *：那等于允许任何人伪造 IP 绕过限流并污染审计日志。
HPF_TRUSTED_PROXIES=172.28.0.0/24
# 上传大小上限（字节，默认 512MiB）；单用户总量另受 users.quota_bytes 限制。
HPF_MAX_UPLOAD_BYTES=536870912

# ---------- 数据库 ----------
POSTGRES_USER=hpf
# 注意：若复用已存在的开发数据卷（hpf-reader_pgdata），这里必须填回当时的口令，
#       否则 api 会因认证失败起不来；若要全新开始，改任意强口令并换卷名。
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=hpf_reader

# ---------- Redis（队列预留） ----------
# 当前实现使用 Postgres 表队列；REDIS_URL 仅作为将来切 asynq 的准备
REDIS_URL=redis://redis:6379/0

# ---------- MinIO / S3（可选，仅 `--profile minio` 时需要）----------
# HPF 默认 HPF_STORAGE_DRIVER=local，书存在 bookfiles 卷里，不依赖对象存储。
MINIO_ROOT_USER=hpfminio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=hpf-books
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- AI 网关 ----------
# fake: 不调用外部服务，按块回显（本地开发/测试用）
# openai: 直连任意 OpenAI 兼容端点（DeepSeek / OpenAI / Ollama / vLLM）
# ⚠️ 接真实供应商时，key 的账单由你承担：务必配合 HPF_REGISTER_OPEN=false 与配额。
HPF_AI_PROVIDER=fake
HPF_AI_BASE_URL=https://api.deepseek.com/v1
HPF_AI_API_KEY=
HPF_AI_MODEL=deepseek-chat
HPF_AI_TIMEOUT=60s
# 每用户每月 AI 调用次数上限
HPF_AI_DAILY_QUOTA=1000
# 全站每月 AI 调用总上限（0 = 不限）。
# 只靠每用户配额无法阻止「批量注册小号」把账单烧穿：N 个小号各跑满 1000 次，
# 成本随注册数线性增长。这个开关是最后一道闸门。
#   - 对外开放注册：建议 50000（约 50 个用户跑满）
#   - 单人自托管：保持 0
# 注意：判定用 SUM(users.ai_calls_used)，不加行锁，N 个并发请求可能同时通过，
# 实际用量可能超出上限约等于并发数。
HPF_AI_GLOBAL_MONTHLY_CALLS=0

# ---------- 合法书源 ----------
HPF_GUTENDEX_URL=https://gutendex.com
HPF_SOURCES_TIMEOUT=8s
