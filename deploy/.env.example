# HPF-Reader 部署配置模板
#   cp .env.example .env   然后替换所有 change-me
#   生成随机密钥：openssl rand -base64 32

# ---------- 域名与 TLS ----------
# 生产填真实域名（Caddy 自动签证书）；本地调试可用 localhost
HPF_DOMAIN=books.example.com
ACME_EMAIL=admin@example.com

# ---------- 服务端 ----------
HPF_ENV=prod
HPF_VERSION=dev
HPF_API_IMAGE=hpf-reader-api:local
HPF_LOG_LEVEL=info
HPF_LOG_FORMAT=json
# 必填：access token 的签名密钥，泄露即可伪造登录态。至少 32 字节随机值。
HPF_JWT_SECRET=vloojr-ehhrv-cukdgvv-cwg-ehhrvhq-hooobt-19
HPF_ACCESS_TOKEN_TTL=15m
HPF_REFRESH_TOKEN_TTL=720h
# 登录失败 5 次锁定 15 分钟
HPF_LOGIN_MAX_FAILURES=5
HPF_LOGIN_LOCK_WINDOW=15m
HPF_REGISTER_OPEN=true
# 每 IP 每分钟请求上限
HPF_RATE_LIMIT_AUTH=20
HPF_RATE_LIMIT_API=600
HPF_METRICS_ENABLED=true
# 允许的跨域来源（多个用逗号分隔）
HPF_CORS_ORIGINS=*
# 反代后的真实 IP 来源；Caddy 在同网络内，因此信任网段
HPF_TRUSTED_PROXIES=*
# 上传大小上限（字节，默认 512MiB）
HPF_MAX_UPLOAD_BYTES=536870912

# ---------- 数据库 ----------
POSTGRES_USER=hpf
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=hpf_reader

# ---------- Redis（队列预留） ----------
# 当前实现使用 Postgres 表队列；REDIS_URL 仅作为将来切 asynq 的准备
REDIS_URL=redis://redis:6379/0

# ---------- MinIO / S3 ----------
MINIO_ROOT_USER=hpfminio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=hpf-books
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- AI 网关 ----------
# fake: 不调用外部服务，按块回显（本地开发/测试用）
# openai: 直连任意 OpenAI 兼容端点（DeepSeek / OpenAI / Ollama / vLLM）
HPF_AI_PROVIDER=fake
HPF_AI_BASE_URL=https://api.deepseek.com/v1
HPF_AI_API_KEY=
HPF_AI_MODEL=deepseek-chat
HPF_AI_TIMEOUT=60s

# ---------- 合法书源 ----------
HPF_GUTENDEX_URL=https://gutendex.com
HPF_SOURCES_TIMEOUT=8s
