<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hpfreader.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\HPF Reader">
    </Installer>
    <PackageInformation
        PackageName="HPF Reader"
        PackageDisplayName="HPF Reader"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.3.1.0"
        PackageDescription="A HPFReader application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.hotpotfish.hpfreader"
                Description="A HPFReader application"
                DisplayName="HPF Reader"
                ExecutableName="hpfreader.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>HPF Reader</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>A HPFReader application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hpfreader.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
